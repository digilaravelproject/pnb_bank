<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Softer/Lighter Black Outline Shadow Ring -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <stroke
                android:width="2.5dp"
                android:color="#22000000" />
        </shape>
    </item>

    <!-- Inner Frosted Glass Panel -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <!-- Frosted Glass Fill -->
            <gradient
                android:angle="270"
                android:endColor="#1CFFFFFF"
                android:startColor="#45FFFFFF"
                android:type="linear" />
            <!-- Inner White Stroke -->
            <stroke
                android:width="1.5dp"
                android:color="#B3FFFFFF" />
            <corners android:radius="25dp" />
        </shape>
    </item>
</layer-list>
