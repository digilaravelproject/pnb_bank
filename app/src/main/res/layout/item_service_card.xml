<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="135dp"
    android:layout_height="125dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_white_service_card"
    android:elevation="4dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Icon Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCardIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💳"
            android:textColor="@color/pnb_red"
            android:textSize="28sp" />

        <!-- Yellow Accent Underline Bar -->
        <View
            android:id="@+id/viewIconUnderline"
            android:layout_width="30dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:background="#F5B400" />

    </LinearLayout>

    <!-- Service Title -->
    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="Card Re-Issuance"
        android:textColor="#2D3748"
        android:textSize="12.5sp"
        android:textStyle="bold" />

</LinearLayout>
