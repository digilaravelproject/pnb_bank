<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_kiosk" />

    <!-- Centered Glass Panel Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="44dp"
        android:paddingTop="36dp"
        android:paddingBottom="85dp">

        <LinearLayout
            android:id="@+id/glassInnerContainer"
            android:layout_width="980dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:clipToOutline="true"
            android:elevation="24dp"
            android:orientation="vertical"
            android:outlineProvider="background"
            android:paddingHorizontal="48dp"
            android:paddingVertical="28dp"
            android:translationZ="8dp">

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Know Your Credit Score"
                android:textColor="@color/pnb_red"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Please fill in the details below to fetch and view your credit score report."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Form Content (Scrollable for flexibility) -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Two Column Grid for inputs -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="3"
                        android:alignmentMode="alignMargins"
                        android:useDefaultMargins="true">

                        <!-- Column 1, Row 1: Name -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full Name"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etFullName"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input_box"
                                android:hint="Enter full name"
                                android:inputType="textPersonName"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Column 2, Row 1: Mobile -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="16dp"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mobile Number"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etMobileNumber"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input_box"
                                android:hint="Enter 10-digit mobile number"
                                android:inputType="phone"
                                android:maxLength="10"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Column 1, Row 2: Document (PAN) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PAN Card Number (Document ID)"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etDocumentId"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input_box"
                                android:hint="Enter 10-character PAN"
                                android:inputType="textCapCharacters"
                                android:maxLength="10"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Column 2, Row 2: Date of Birth -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="16dp"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date of Birth"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etDateOfBirth"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input_box"
                                android:hint="DD-MM-YYYY"
                                android:inputType="date"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Column 1, Row 3: Address -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full Address"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etAddress"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input_box"
                                android:hint="Enter residential address"
                                android:inputType="textPostalAddress"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Column 2, Row 3: Pincode -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_marginStart="16dp"
                            android:layout_marginBottom="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pincode"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <EditText
                                android:id="@+id/etPincode"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_input_box"
                                android:hint="Enter 6-digit pincode"
                                android:inputType="number"
                                android:maxLength="6"
                                android:paddingHorizontal="16dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_hint"
                                android:textSize="16sp" />
                        </LinearLayout>

                    </GridLayout>

                    <!-- Error Text -->
                    <TextView
                        android:id="@+id/tvFormError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/pnb_red"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>
            </ScrollView>

        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM-LEFT BACK BUTTON CONTAINER (Formerly Home) -->
    <LinearLayout
        android:id="@+id/btnBackContainer"
        android:layout_width="190dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_proceed_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- BOTTOM-RIGHT SUBMIT BUTTON CONTAINER (Formerly Back) -->
    <LinearLayout
        android:id="@+id/btnSubmitCreditScore"
        android:layout_width="190dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_proceed_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
