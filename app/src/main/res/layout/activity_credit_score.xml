<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_kiosk" />

    <!-- Centered Glass Panel Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="85dp">

        <LinearLayout
            android:id="@+id/glassInnerContainer"
            android:layout_width="1080dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:clipToOutline="true"
            android:elevation="24dp"
            android:orientation="vertical"
            android:outlineProvider="background"
            android:paddingHorizontal="36dp"
            android:paddingVertical="28dp"
            android:translationZ="8dp">

            <!-- Title & Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Know Your Credit Score"
                android:textColor="@color/pnb_red"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Please fill in the details below to fetch and view your credit score report."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Horizontal Split Layout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Left Column: Form Panel (Only 3 inputs now) -->
                <LinearLayout
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Full Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Full Name"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_box"
                        android:hint="Enter full name"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="18sp" />

                    <!-- Mobile -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Mobile Number"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etMobileNumber"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_box"
                        android:hint="10-digit mobile"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="18sp" />

                    <!-- Document (PAN) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="PAN Card (Doc ID)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etDocumentId"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_input_box"
                        android:hint="Enter 10-char PAN"
                        android:inputType="textCapCharacters"
                        android:maxLength="10"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="18sp" />

                    <!-- Error Text -->
                    <TextView
                        android:id="@+id/tvFormError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/pnb_red"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Divider Line between Form and Keyboard Panel -->
                <View
                    android:layout_width="1.5dp"
                    android:layout_height="260dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/divider" />

                <!-- Right Column Panel: Guide Banner / Keyboards -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical">

                    <!-- 1. Info / Guide Banner -->
                    <LinearLayout
                        android:id="@+id/layoutGuideBanner"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        android:background="@drawable/bg_keyboard_container"
                        android:elevation="8dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📊"
                            android:textSize="48sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Instant Credit Rating"
                            android:textColor="@color/pnb_red"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="Safe, secure, and official credit rating checks. Tap any input field to begin typing."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <!-- 2. Integrated Dynamic Keyboard Container -->
                    <LinearLayout
                        android:id="@+id/layoutKeyboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- QWERTY Keyboard -->
                        <FrameLayout
                            android:id="@+id/containerQwerty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="visible">
                            <include layout="@layout/layout_qwerty_keyboard" />
                        </FrameLayout>

                        <!-- Numeric Keypad -->
                        <FrameLayout
                            android:id="@+id/containerNumeric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone">
                            <include layout="@layout/layout_numeric_keypad" />
                        </FrameLayout>

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM-LEFT BACK BUTTON CONTAINER -->
    <LinearLayout
        android:id="@+id/btnBackContainer"
        android:layout_width="190dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_proceed_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- BOTTOM-RIGHT SUBMIT BUTTON CONTAINER -->
    <LinearLayout
        android:id="@+id/btnSubmitCreditScore"
        android:layout_width="190dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_proceed_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
