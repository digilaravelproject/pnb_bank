<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/bg_kiosk" />

    <!-- Responsive Floating Glass Panel Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="40dp"
        android:paddingTop="80dp"
        android:paddingBottom="110dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardGlassContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/glassInnerContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:paddingHorizontal="44dp"
                android:paddingVertical="32dp">

                <!-- STEP 1: Main Categories Screen -->
                <LinearLayout
                    android:id="@+id/layoutCategoriesScreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Digital Banking Services"
                        android:textColor="@color/pnb_red"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Select a category to explore digital loan journeys and banking services"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />

                    <ScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp">

                        <GridLayout
                            android:id="@+id/gridCategories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:alignmentMode="alignMargins"
                            android:columnCount="5"
                            android:useDefaultMargins="true" />
                    </ScrollView>

                </LinearLayout>


                <!-- STEP 2: Services List Screen -->
                <LinearLayout
                    android:id="@+id/layoutServicesListScreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCategoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Digital Lending Services"
                        android:textColor="@color/pnb_red"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCategorySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Select a service to launch digital application portal"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />

                    <ScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp">

                        <GridLayout
                            android:id="@+id/gridServices"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:alignmentMode="alignMargins"
                            android:columnCount="6"
                            android:useDefaultMargins="true" />
                    </ScrollView>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- FULL SCREEN BOTTOM-LEFT HOME / BACK BUTTON CONTAINER -->
    <LinearLayout
        android:id="@+id/btnHomeContainer"
        android:layout_width="260dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_proceed_button"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivHomeIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_home_pnb"
            android:visibility="visible" />

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
