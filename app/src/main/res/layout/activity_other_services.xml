<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image (Controlled globally via res/drawable/bg_kiosk.xml; change bitmap src in bg_kiosk.xml to switch back to @drawable/bg_kiosk_old) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_kiosk" />

    <!-- Responsive Floating Glass Panel Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="44dp"
        android:paddingTop="44dp"
        android:paddingBottom="85dp">

        <LinearLayout
            android:id="@+id/glassInnerContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:clipToOutline="true"
            android:elevation="24dp"
            android:orientation="vertical"
            android:outlineProvider="background"
            android:paddingHorizontal="36dp"
            android:paddingVertical="20dp"
            android:translationZ="8dp">

                <!-- STEP 1: Main Categories Screen -->
                <LinearLayout
                    android:id="@+id/layoutCategoriesScreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Value Added Services"
                        android:textColor="@color/pnb_red"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Select a category to explore digital loan journeys and banking services"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <ScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:overScrollMode="never">

                        <GridLayout
                            android:id="@+id/gridCategories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:alignmentMode="alignMargins"
                            android:columnCount="6"
                            android:useDefaultMargins="true" />
                    </ScrollView>

                </LinearLayout>


                <!-- STEP 2: Services List Screen -->
                <LinearLayout
                    android:id="@+id/layoutServicesListScreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCategoryTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Digital Lending Services"
                        android:textColor="@color/pnb_red"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCategorySubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Select a service to launch digital application portal"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <ScrollView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:overScrollMode="never">

                        <GridLayout
                            android:id="@+id/gridServices"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:alignmentMode="alignMargins"
                            android:columnCount="7"
                            android:useDefaultMargins="true" />
                    </ScrollView>

                </LinearLayout>

            </LinearLayout>

    </LinearLayout>

    <!-- BOTTOM-LEFT HOME BUTTON CONTAINER -->
    <LinearLayout
        android:id="@+id/btnHomeContainer"
        android:layout_width="190dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_proceed_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivHomeIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_home_pnb" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- BOTTOM-RIGHT BACK BUTTON CONTAINER -->
    <LinearLayout
        android:id="@+id/btnBackContainer"
        android:layout_width="190dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_proceed_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
