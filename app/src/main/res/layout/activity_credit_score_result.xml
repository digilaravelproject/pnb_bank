<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_kiosk" />

    <!-- Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="85dp">

        <LinearLayout
            android:id="@+id/glassInnerContainer"
            android:layout_width="1200dp"
            android:layout_height="480dp"
            android:background="@drawable/bg_glass_card"
            android:clipToOutline="true"
            android:elevation="24dp"
            android:orientation="vertical"
            android:outlineProvider="background"
            android:paddingHorizontal="36dp"
            android:paddingVertical="32dp"
            android:translationZ="8dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Credit Score Report"
                android:textColor="@color/pnb_red"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Horizontal Split -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Left Column: Score Rating Area with Arc Gauge -->
                <LinearLayout
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Here is your credit rate 🙂"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Arc Gauge Container -->
                    <FrameLayout
                        android:layout_width="300dp"
                        android:layout_height="165dp"
                        android:layout_marginTop="16dp">

                        <!-- Custom Gauge View -->
                        <com.pnb.bank.ui.views.ArcGaugeView
                            android:id="@+id/arcGaugeView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- Center Score Content Panel -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="15dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <!-- Dynamic Score Value (Big) -->
                            <TextView
                                android:id="@+id/tvResultScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="755"
                                android:textColor="@color/text_primary"
                                android:textSize="58sp"
                                android:textStyle="bold" />

                            <!-- Rating (e.g. Excellent) -->
                            <TextView
                                android:id="@+id/tvResultRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Excellent Rating"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Version/Type info -->
                    <TextView
                        android:id="@+id/tvResultScoreDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Type: ERS | Version: 3.1"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="1.5dp"
                    android:layout_height="220dp"
                    android:layout_marginHorizontal="30dp"
                    android:background="@color/divider" />

                <!-- Right Column: Personal Information Panel -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSONAL INFORMATION"
                        android:textColor="@color/pnb_gold"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <!-- Name info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Full Name:"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvResultName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manish Gupta"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- DOB info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Date of Birth:"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvResultDob"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1996-02-21"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Gender info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Gender:"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvResultGender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Male"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Age info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:text="Age:"
                            android:textColor="@color/text_secondary"
                            android:textSize="16sp" />
                        <TextView
                            android:id="@+id/tvResultAge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="27 Years"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- Done Button (Bottom Right) -->
    <LinearLayout
        android:id="@+id/btnResultDone"
        android:layout_width="190dp"
        android:layout_height="72dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_proceed_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
