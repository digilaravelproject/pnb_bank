<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base App Theme -->
    <style name="Theme.PNBBank" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/pnb_red</item>
        <item name="colorPrimaryDark">@color/pnb_red_dark</item>
        <item name="colorAccent">@color/pnb_gold</item>
        <item name="android:windowBackground">@color/bg_white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- Card Style -->
    <style name="PNBCard">
        <item name="android:background">@drawable/bg_card_white</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Primary Button -->
    <style name="PNBButton">
        <item name="android:background">@drawable/bg_button_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Outlined Button -->
    <style name="PNBButtonOutlined">
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:textColor">@color/pnb_red</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Section Header Text -->
    <style name="TextSectionHeader">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/pnb_red</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Title Text -->
    <style name="TextTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Body Text -->
    <style name="TextBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Custom QWERTY Keyboard Key Style -->
    <style name="QwertyKeyStyle">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/bg_qwerty_key</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
